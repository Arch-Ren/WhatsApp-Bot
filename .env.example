# Kunci API untuk fitur chatbot. Bot coba Groq dulu (paling cepat),
# kalau gagal/limit otomatis fallback ke Cerebras.
# Groq: https://console.groq.com | Cerebras: https://cloud.cerebras.ai
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

CEREBRAS_API_KEY=your_cerebras_api_key_here
CEREBRAS_MODEL=llama-3.3-70b

# Nomor WA kamu sendiri (owner), format 62xxxxxxxxxx, tanpa +/spasi
BOT_OWNER_NUMBER=628xxxxxxxxxx

# Personality default yang dipakai bot saat belum diatur per-chat
DEFAULT_PERSONALITY=default

# Prefix command, default titik (.sticker, .chat, dst)
COMMAND_PREFIX=.
